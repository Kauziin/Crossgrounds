return function(t)
 local Intent=require(game.ReplicatedStorage.Crossgrounds.AimAssistIntent)
 local Profiles=require(game.ReplicatedStorage.Crossgrounds.GraphicsProfiles)
 t.test("touch ownership and forward elapsed time expire intent",function()
  local c={device="touch",look=Vector2.new(.5,0),touchOwned=true,touchAt=10,now=10.05}
  t.expect.equal(Intent.Resolve(c),c.look)
  c.now=10.2 t.expect.equal(Intent.Resolve(c),Vector2.zero)
  c.now=9.9 t.expect.equal(Intent.Resolve(c),Vector2.zero)
  c.now=10.05 c.touchOwned=false t.expect.equal(Intent.Resolve(c),Vector2.zero)
 end)
 t.test("focus menus mouse and neutral gamepad never supply tracking intent",function()
  local c={device="gamepad",look=Vector2.new(.5,0),focused=false}
  t.expect.equal(Intent.Resolve(c),Vector2.zero)
  c.focused=true c.blocked=true t.expect.equal(Intent.Resolve(c),Vector2.zero)
  c.blocked=false c.device="mouse" t.expect.equal(Intent.Resolve(c),Vector2.zero)
  c.device="gamepad" c.look=Vector2.zero t.expect.equal(Intent.Resolve(c),Vector2.zero)
 end)
 t.test("malformed intent cannot rotate a camera",function()
  t.expect.equal(Intent.Resolve({device="gamepad",look=Vector2.new(0/0,0)}),Vector2.zero)
  t.expect.equal(Intent.Resolve({device="gamepad",look=Vector2.new(math.huge,0)}),Vector2.zero)
 end)
 t.test("balanced is default and fidelity requires explicit higher setting",function()
  t.expect.equal(Profiles.Get(nil).Name,"Equilibrado")
  t.expect.equal(Profiles.Get(999).Name,"Equilibrado")
  t.expect.truthy(Profiles.Get(4).Bloom>Profiles.Get(2).Bloom)
  t.expect.falsy(Profiles.Get(1).Shadows)
  t.expect.truthy(Profiles.Get(3).LightShadows)
 end)
end
