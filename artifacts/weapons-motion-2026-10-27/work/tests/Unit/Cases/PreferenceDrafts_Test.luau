return function(t)
 local Drafts=require(game.ReplicatedStorage.Crossgrounds.PreferenceDrafts)
 local Profile=require(game.ReplicatedStorage.Crossgrounds.PreferenceProfile)
 local path="Global|FieldOfView"
 local function snapshot(revision,sequence,value)
  local p=Profile.New() p.Global.FieldOfView=value
  return {version=1,revision=revision,profile=p,acks={[path]=sequence}}
 end
 t.test("older confirmations cannot overwrite a newer local draft",function()
  local d=Drafts.new() d:Apply(snapshot(0,0,70))
  d:Stage("FieldOfView","Global",71) d:Stage("FieldOfView","Global",72)
  d:Apply(snapshot(1,1,71)) t.expect.equal(d:Value("FieldOfView","Global"),72)
  d:Apply(snapshot(2,2,72)) t.expect.equal(d:Value("FieldOfView","Global"),72) t.expect.equal(next(d.drafts),nil)
 end)
 t.test("oscillating back to the same value still requires the matching sequence",function()
  local d=Drafts.new() d:Apply(snapshot(0,0,70))
  d:Stage("FieldOfView","Global",71) d:Stage("FieldOfView","Global",72) d:Stage("FieldOfView","Global",71)
  d:Apply(snapshot(1,1,71)) t.expect.truthy(d.drafts[path])
  d:Apply(snapshot(2,2,72)) t.expect.equal(d:Value("FieldOfView","Global"),71)
  d:Apply(snapshot(3,3,71)) t.expect.equal(next(d.drafts),nil)
 end)
 t.test("35 rapid increments survive delayed acknowledgements",function()
  local d=Drafts.new() d:Apply(snapshot(0,0,70))
  for i=1,35 do
   d:Stage("FieldOfView","Global",d:Value("FieldOfView","Global")+1)
   if i>3 then d:Apply(snapshot(i-3,i-3,70+i-3)) end
  end
  t.expect.equal(d:Value("FieldOfView","Global"),105)
  d:Apply(snapshot(35,35,105)) t.expect.equal(next(d.drafts),nil)
 end)
 t.test("out of order snapshots cannot restore older confirmed data",function()
  local d=Drafts.new() d:Apply(snapshot(3,3,90))
  t.expect.falsy(d:Apply(snapshot(2,2,80))) t.expect.equal(d:Value("FieldOfView","Global"),90)
 end)
 t.test("explicit false and pending inheritance remain distinct",function()
  local d=Drafts.new() local p=Profile.New() p.Global.ReticleDynamic=true p.Modes.arena.ReticleDynamic=true
  d:Apply({version=1,revision=0,profile=p,acks={}})
  d:Stage("ReticleDynamic","Mode:arena",false) t.expect.equal(d:Value("ReticleDynamic","Mode:arena"),false)
  local seq=d:Stage("ReticleDynamic","Mode:arena",nil,true)
  local value,custom=d:Value("ReticleDynamic","Mode:arena") t.expect.equal(value,true) t.expect.falsy(custom)
  p.Modes.arena.ReticleDynamic=nil
  d:Apply({version=1,revision=1,profile=p,acks={["Mode:arena|ReticleDynamic"]=seq}})
  t.expect.equal(next(d.drafts),nil)
 end)
 t.test("acknowledging one field cannot clear another field or mode",function()
  local d=Drafts.new() d:Stage("FieldOfView","Global",80) d:Stage("ReticleColor","Mode:arena",3)
  d:Apply(snapshot(1,1,80)) t.expect.truthy(d.drafts["Mode:arena|ReticleColor"])
  t.expect.equal(d:Value("ReticleColor","Mode:arena"),3)
 end)
 t.test("reset sequences supersede earlier edits and permit later edits",function()
  local d=Drafts.new() d:Stage("FieldOfView","Global",80)
  local reset=d:NextSequence() d:Stage("FieldOfView","Global",70,false,reset)
  d:Apply(snapshot(1,1,80)) t.expect.equal(d:Value("FieldOfView","Global"),70)
  local later=d:Stage("FieldOfView","Global",71)
  d:Apply(snapshot(2,reset,70)) t.expect.equal(d:Value("FieldOfView","Global"),71)
  d:Apply(snapshot(3,later,71)) t.expect.equal(next(d.drafts),nil)
 end)
 t.test("new clients continue sequence numbers and invalid fields are rejected",function()
  local d=Drafts.new() d:Apply(snapshot(3,50,90))
  t.expect.equal(d:Stage("FieldOfView","Global",91),51)
  t.expect.equal(d:Stage("Damage","Global",900),nil)
  t.expect.equal(d:Stage("FieldOfView","Mode:arena",90),nil)
 end)
end
