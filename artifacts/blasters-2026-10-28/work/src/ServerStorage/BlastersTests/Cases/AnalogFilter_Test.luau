return function(t)
 local Filter=require(game.ReplicatedStorage.Crossgrounds.AnalogFilter)
 local Settings=require(game.ReplicatedStorage.ExperienceSettings)
 t.test("defaults suppress 5 percent left and 10 percent right drift",function()
  t.expect.equal(Settings.Rules.LeftStickDeadzone.Default,.05) t.expect.equal(Settings.Rules.RightStickDeadzone.Default,.1)
  t.expect.equal(Filter.Radial(Vector2.new(.049,0),.05).Magnitude,0)
  t.expect.equal(Filter.Radial(Vector2.new(.099,0),.1).Magnitude,0)
  t.expect.truthy(Filter.Radial(Vector2.new(.06,0),.05).Magnitude>0)
 end)
 t.test("radial rescaling preserves direction and full tilt",function()
  local diagonal=Vector2.new(.6,.8) local result=Filter.Radial(diagonal,.1)
  t.expect.truthy((diagonal-result).Magnitude<.0001)
  local partial=Filter.Radial(Vector2.new(.55,0),.1) t.expect.truthy(math.abs(partial.X-.5)<.0001)
 end)
 t.test("zero deadzone and negative axis work without NaN",function()
  t.expect.equal(Filter.Radial(Vector2.zero,0).Magnitude,0)
  t.expect.equal(Filter.Axis(-1,.4),-1) t.expect.equal(Filter.Axis(.05,.1),0)
 end)
 t.test("settings clamp out of range values and format percentages",function()
  t.expect.equal(Settings:Sanitize("LeftStickDeadzone",-1),0) t.expect.equal(Settings:Sanitize("RightStickDeadzone",9),.4)
  t.expect.equal(Settings:Format("RightStickDeadzone",.1),"10%") t.expect.equal(Settings:Sanitize("AimAssistStrength",9),1)
  t.expect.equal(Settings:Sanitize("LeftStickDeadzone",0/0),nil)
 end)
end
