return function(t)
 local G=require(game.ReplicatedStorage.Crossgrounds.WeaponGripReferences)
 t.test("source translation does not move normalized hand references",function()
  local m=Instance.new("Model")
  local a=Instance.new("Part",m) a.Name="Trigger" a.Position=Vector3.new(4,5,6)
  local b=Instance.new("Part",m) b.Name="Handguard" b.Position=Vector3.new(2,6,6) b.Size=Vector3.new(2,.5,.3)
  local origin,support=G.Resolve(m,"jak_12")
  a.Position+=Vector3.new(100,20,-50) b.Position+=Vector3.new(100,20,-50)
  local o,s=G.Resolve(m,"jak_12")
  t.expect.truthy(((s-o)-(support-origin)).Magnitude<.001)
  m:Destroy()
 end)
 t.test("unregistered weapons keep their existing grip and missing references fail explicitly",function()
  local m=Instance.new("Model")
  t.expect.equal(G.Resolve(m,"ax_50"),nil)
  t.expect.throws(function() G.Resolve(m,"jak_12") end)
  m:Destroy()
 end)
end
