return function(t)
 local Root=game.ReplicatedStorage.Crossgrounds local P=require(Root.CareerPolicy)local F=require(Root.ProfileFramePolicy)local Icons=require(Root.InterfaceIcons)
 t.test("all interface roles have distinct library art",function()
  local seen={}for role,name in Icons.Roles do t.expect.truthy(Icons.Asset(role))t.expect.falsy(seen[name])seen[name]=true end
 end)
 t.test("arbitrary RGB colors are accepted for owned layers",function()
  local p=P.New()t.expect.truthy(F.Set(p,{{frame="default",color={13,47,229}},{frame="default",color={255,0,128}}}))t.expect.equal(#p.frameLayers,2)t.expect.equal(p.frameLayers[1].color[1],13)
 end)
 t.test("locked designs cannot be layered",function()
  local p=P.New()t.expect.falsy(F.Set(p,{{frame="legend",color={1,2,3}}}))t.expect.equal(p.frameLayers,nil)
 end)
 t.test("malformed RGB and oversized or sparse layouts are rejected",function()
  for _,rgb in {{-1,2,3},{256,2,3},{1.2,2,3},{0/0,2,3},{1,2},{1,2,3,4}}do t.expect.equal(F.Validate({{frame="default",color=rgb}}),nil)end
  local layers={}for i=1,5 do layers[i]={frame="default",color={1,2,3}}end t.expect.equal(F.Validate(layers),nil)
  t.expect.equal(F.Validate({[1]=layers[1],[3]=layers[2]}),nil)
 end)
 t.test("composition is copied and survives resets and migration",function()
  local p=P.New()local draft={{frame="default",color={13,47,229}}}F.Set(p,draft)draft[1].color[1]=255 t.expect.equal(p.frameLayers[1].color[1],13)
  p.cycleXP=P.CycleCost P.Transition(p)local saved=P.Migrate(p)t.expect.equal(saved.frameLayers[1].color[1],13)
  local public=P.Public(saved,1,"Player")public.frameLayers[1].color[1]=0 t.expect.equal(saved.frameLayers[1].color[1],13)
 end)
 t.test("legacy frame remains compatible; single selection resets layers",function()
  local p=P.New()t.expect.truthy(P.Migrate(p))F.Set(p,{{frame="default",color={13,47,229}}})t.expect.truthy(P.EquipIdentity(p,"frame","default"))t.expect.equal(p.frameLayers,nil)
 end)
 t.test("invalid stored layers do not replace a profile",function()
  local p=P.New()p.frameLayers={{frame="legend",color={1,2,3}}}t.expect.equal(P.Migrate(p),nil)
 end)
end
