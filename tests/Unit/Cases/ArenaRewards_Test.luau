return function(t)
 local Rewards=require(game.ServerScriptService.Crossgrounds.ArenaRewards)
 local function player() return setmetatable({attributes={}},{__index={GetAttribute=function(self,key) return self.attributes[key] end,SetAttribute=function(self,key,value) self.attributes[key]=value end}}) end
 t.test("training eliminations award 10 XP without PvP kills",function()
  local p=player() local r=Rewards.Apply(p,nil,true)
  t.expect.equal(r.xp,10) t.expect.truthy(r.training) t.expect.equal(p:GetAttribute("ArenaKills"),nil) t.expect.equal(p:GetAttribute("ArenaSessionXP"),10)
 end)
 t.test("body and headshot rewards accumulate within the session",function()
  local p=player() local body=Rewards.Apply(p,{},false) local head=Rewards.Apply(p,{},true)
  t.expect.equal(body.xp,100) t.expect.equal(head.xp,150) t.expect.equal(head.bonusXP,50)
  t.expect.equal(head.sessionXP,250) t.expect.equal(p:GetAttribute("ArenaKills"),2)
 end)
 t.test("Arena pistol loses its one body shot kill at long range",function()
  local Kits=require(game.ReplicatedStorage.KitDefinitions) local Def=require(game.ReplicatedStorage.Crossgrounds.ArenaDefinitions)
  t.expect.equal(Def.Health,20) t.expect.truthy(Kits.ShotDamage(Kits.Weapons.ArenaPistol,0,false)>=Def.Health)
  t.expect.truthy(Kits.ShotDamage(Kits.Weapons.ArenaPistol,Kits.Weapons.ArenaPistol.Range,false)<Def.Health)
  t.expect.truthy(Kits.ShotDamage(Kits.Weapons.ArenaPistol,Kits.Weapons.ArenaPistol.Range,true)>=Def.Health)
 end)
end
