return function(t)
 local Policy=require(game.ServerScriptService.Crossgrounds.ProgressionPolicy)
 t.test("bots give 50 XP with no headshot bonus",function()
  t.expect.equal(Policy.Reward("bot",false).XP,50) t.expect.equal(Policy.Reward("bot",true).XP,50)
  t.expect.equal(Policy.Reward("bot",false).BotKills,1)
 end)
 t.test("training gives 10 XP and no combat kill",function()
  local reward=Policy.Reward("training",true)
  t.expect.equal(reward.XP,10) t.expect.equal(reward.Kills,nil) t.expect.equal(reward.Coins,nil)
 end)
 t.test("missing and unrelated records never qualify as played",function()
  t.expect.falsy(Policy.HasPlayed(nil)) t.expect.falsy(Policy.HasPlayed({})) t.expect.falsy(Policy.HasPlayed({XP="0"}))
  t.expect.truthy(Policy.HasPlayed({XP=0})) t.expect.truthy(Policy.HasPlayed({HasPlayed=true}))
 end)
 t.test("friend limit applies to eligible records, not the first friends",function()
  local candidates={{Id=1},{Id=2},{Id=3},{Id=4}} local data={[2]={XP=0},[4]={XP=10}}
  local rows=Policy.CollectFriends(candidates,function(id) return data[id] end,2)
  t.expect.equal(#rows,2) t.expect.equal(rows[1].friend.Id,2) t.expect.equal(rows[2].friend.Id,4)
 end)
end
