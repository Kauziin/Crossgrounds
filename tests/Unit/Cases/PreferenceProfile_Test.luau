return function(t)
 local Profile=require(game.ReplicatedStorage.Crossgrounds.PreferenceProfile)
 local Rules=require(game.ReplicatedStorage.ExperienceSettings)
 t.test("old flat preferences migrate without losing device controls",function()
  local p=Profile.Migrate({FieldOfView=90,RightStickDeadzone=.13,BindFireGamepad="ButtonR2"})
  t.expect.equal(p.Version,2) t.expect.equal(p.Global.FieldOfView,90)
  t.expect.truthy(math.abs(p.Devices.Gamepad.RightStickDeadzone-.13)<.0001)
  t.expect.equal(p.Devices.Gamepad.BindFireGamepad,"ButtonR2")
 end)
 t.test("global and mode overrides resolve without copying global values",function()
  local p=Profile.New() Profile.Set(p,"Global","ReticleColor",2) Profile.Set(p,"Mode:arena","ReticleColor",3)
  t.expect.equal(Profile.Resolve(p,"ReticleColor","arena"),3) t.expect.equal(Profile.Resolve(p,"ReticleColor","ctf"),2)
  t.expect.equal(Profile.Resolve(p,"ReticleColor","getout"),2) t.expect.equal(p.Modes.ctf.ReticleColor,nil)
  Profile.Set(p,"Global","ReticleColor",4) t.expect.equal(Profile.Resolve(p,"ReticleColor","ctf"),4) t.expect.equal(Profile.Resolve(p,"ReticleColor","arena"),3)
 end)
 t.test("restore a default differs from removing an override, including false",function()
  local p=Profile.New() Profile.Set(p,"Global","ReticleDynamic",true) Profile.Set(p,"Mode:arena","ReticleDynamic",false)
  t.expect.equal(Profile.Resolve(p,"ReticleDynamic","arena"),false)
  Profile.Set(p,"Mode:arena","ReticleDynamic",nil,true) t.expect.equal(Profile.Resolve(p,"ReticleDynamic","arena"),true)
 end)
 t.test("corrupt and unknown fields fall back safely",function()
  local p=Profile.Migrate({Version=2,Global={MenuScale=math.huge,ReticleColor=99,Damage=999},Modes="invalid",Devices={Touch={TouchFireX=99}}})
  t.expect.equal(Profile.Resolve(p,"MenuScale","hub"),1) t.expect.equal(Profile.Resolve(p,"ReticleColor","ctf"),1)
  t.expect.equal(p.Global.Damage,nil) t.expect.equal(p.Devices.Touch.TouchFireX,.96)
  t.expect.equal(Profile.Migrate({Version=2,Global=2,Devices=1}).Version,2)
 end)
 t.test("unimplemented modes and disallowed scope matrices cannot be written",function()
  local p=Profile.New()
  t.expect.falsy(Profile.Set(p,"Mode:duels","ReticleColor",2)) t.expect.falsy(Profile.Set(p,"Mode:getout","ReticleColor",2))
  t.expect.falsy(Profile.Set(p,"Mode:arena","MenuScale",1.2)) t.expect.falsy(Profile.Set(p,"Global","RightStickDeadzone",.2))
  t.expect.falsy(Profile.Set(p,"Device:Gamepad","Damage",999))
 end)
 t.test("scales and numeric values are finite, stepped and bounded",function()
  t.expect.equal(Rules:Sanitize("MenuScale",9),1.3) t.expect.equal(Rules:Sanitize("FontScale",0/0),nil)
  t.expect.equal(Rules:Sanitize("HUDScale",-9),.8) t.expect.equal(Rules:Sanitize("ReticleColor",10),nil)
  for key,rule in Rules.Rules do
   local value=Rules:Sanitize(key,rule.Default)
   if typeof(value)=="number" then t.expect.truthy(math.abs(value-rule.Default)<.000001)
   else t.expect.equal(value,rule.Default) end
  end
 end)
 t.test("profiles and default tables are isolated between players",function()
  local a,b=Profile.New(),Profile.New() Profile.Set(a,"Mode:ctf","HUDScale",1.2)
  t.expect.equal(Profile.Resolve(b,"HUDScale","ctf"),1) t.expect.equal(b.Modes.ctf.HUDScale,nil)
 end)
 t.test("registered options have explicit categories, scope and applicators",function()
  for key,rule in Rules.Rules do t.expect.equal(rule.Id,key) t.expect.truthy(rule.Category) t.expect.truthy(rule.Scope) t.expect.equal(rule.Apply,"Setting"..key) end
  t.expect.equal(Rules.Rules.FieldOfView.Category,"Camera") t.expect.equal(Rules.Rules.AimAssist.Category,"Aim")
 end)
end
