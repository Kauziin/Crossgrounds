return function(t)
 local P=require(game.ReplicatedStorage.Crossgrounds.CareerPolicy)
 local Catalog=require(game.ReplicatedStorage.Crossgrounds.ClanCatalog)
 local C=require(game.ServerScriptService.Crossgrounds.ClanPolicy)
 local Repository=require(game.ServerScriptService.Crossgrounds.ClanRepository)
 local function data()return {id="00000000-0000-0000-0000-000000000001",userId=1,epoch="leader-epoch",name="Fixture",tag="FIX",emblem="star",color="teal",displayName="Leader",career={XP=10000,Kills=10}}end
 local function clan()return C.New(data(),0)end
 local function join(record,id,epoch)
  assert(C.Invite(record,1,id,"invite"..id,0,60))
  assert(C.Join(record,{userId=id,epoch=epoch or("epoch"..id),invite="invite"..id,displayName="Member"..id,career={XP=1000}},0,30))
 end
 local function store()
  local s={data={}}
  function s:GetAsync(key)if self.failRead then error("read failed")end return P.Copy(self.data[key])end
  function s:UpdateAsync(key,fn)
   local value=fn(P.Copy(self.data[key]))if value then self.data[key]=P.Copy(value)end
   if self.loseReply then self.loseReply=false error("response lost")end
   return P.Copy(value)
  end
  return s
 end
 t.test("new clan imports roster history but not clan accomplishments",function()
  local record=clan()local current,earned=C.Scores(record)
  t.expect.equal(current.XP,10000)t.expect.equal(earned.XP,0)t.expect.truthy(C.Validate(record))
 end)
 t.test("joining changes roster sum and cannot import old XP as contribution",function()
  local record=clan()join(record,2)local current,earned=C.Scores(record)
  t.expect.equal(current.XP,11000)t.expect.equal(earned.XP,0)
 end)
 t.test("only leader and officers invite; capacity and expiry rechecked",function()
  local record=clan()join(record,2)
  t.expect.falsy(C.Invite(record,2,3,"third",0,60))
  C.Invite(record,1,3,"third",0,60)
  t.expect.falsy(C.Join(record,{userId=3,epoch="E3",invite="third"},0,2))
  t.expect.falsy(C.Join(record,{userId=3,epoch="E3",invite="third"},61,30))
 end)
 t.test("cumulative contribution tolerates duplicate and older delivery",function()
  local record=clan()join(record,2)
  local update={userId=2,epoch="epoch2",contribution={XP=100,ctf_XP=100,Kills=1},career={XP=1100}}
  C.Contribute(record,{update})C.Contribute(record,{update})
  update.contribution.XP=80 update.contribution.ctf_XP=80 update.career.XP=1050 C.Contribute(record,{update})
  local current,earned=C.Scores(record)t.expect.equal(earned.XP,100)t.expect.equal(earned.ctf_XP,100)t.expect.equal(current.XP,11100)
 end)
 t.test("leave removes history from current roster and preserves earned totals",function()
  local record=clan()join(record,2)C.Contribute(record,{{userId=2,epoch="epoch2",contribution={XP=100},career={XP=1100}}})
  t.expect.truthy(C.Remove(record,2,2,"epoch2"))local current,earned=C.Scores(record)
  t.expect.equal(current.XP,10000)t.expect.equal(earned.XP,100)
 end)
 t.test("old membership stream cannot credit a rejoined user",function()
  local record=clan()join(record,2)C.Remove(record,2,2,"epoch2")join(record,2,"new-epoch")
  C.Contribute(record,{{userId=2,epoch="epoch2",contribution={XP=9000},career={XP=10000}}})
  t.expect.equal(record.totals.XP,nil)t.expect.falsy(C.Remove(record,1,2,"epoch2"))
 end)
 t.test("leader must transfer before leaving; officers cannot remove leader",function()
  local record=clan()join(record,2)t.expect.falsy(C.Remove(record,1,1,"leader-epoch"))
  t.expect.truthy(C.Role(record,1,2,"epoch2","officer"))t.expect.falsy(C.Remove(record,2,1,"leader-epoch"))
  t.expect.truthy(C.Transfer(record,1,2,"epoch2"))t.expect.equal(record.members["2"].role,"leader")t.expect.equal(record.members["1"].role,"officer")
 end)
 t.test("last member archives clan without erasing history",function()
  local record=clan()record.totals.XP=5000
  t.expect.truthy(C.Remove(record,1,1,"leader-epoch"))t.expect.truthy(record.archived)t.expect.equal(record.totals.XP,5000)t.expect.truthy(C.Validate(record))
 end)
 t.test("future schema and corrupt leadership fail closed",function()
  local record=clan()record.version=2 t.expect.falsy(C.Validate(record))
  record=clan()record.members["1"].role="member"t.expect.falsy(C.Validate(record))
 end)
 t.test("clan level thresholds do not depend on member history",function()
  t.expect.equal(Catalog.Level(0),1)t.expect.equal(Catalog.Level(4999),1)t.expect.equal(Catalog.Level(5000),2)t.expect.equal(Catalog.Level(20000),3)
 end)
 t.test("uncertain create is idempotent",function()
  local s=store()local r=Repository.new(s,{clock=function()return 0 end})s.loseReply=true
  t.expect.falsy(r:Create(data()))local ok,record=r:Create(data())t.expect.truthy(ok)t.expect.equal(C.Count(record.members),1)
 end)
 t.test("abort fences a late pending creation",function()
  local s=store()local r=Repository.new(s,{clock=function()return 0 end})local d=data()
  t.expect.truthy(r:Abort(d.id,1,d.epoch,{kind="create",data=d}))t.expect.falsy(r:Create(d))
 end)
 t.test("abort revokes invite and fences a late pending join",function()
  local s=store()local r=Repository.new(s,{clock=function()return 0 end})r:Create(data())
  r:Update(data().id,function(record)return C.Invite(record,1,2,"token",0,60)end)
  local d={userId=2,epoch="E2",invite="token",displayName="Two",career={XP=1}}
  t.expect.truthy(r:Abort(data().id,2,"E2",{kind="join",data=d}))t.expect.falsy(r:Join(data().id,d))
 end)
 t.test("uncertain contribution never doubles clan XP",function()
  local s=store()local r=Repository.new(s,{clock=function()return 0 end})r:Create(data())
  local updates={{userId=1,epoch="leader-epoch",contribution={XP=100},career={XP=10100}}}
  s.loseReply=true t.expect.falsy(r:Contribute(data().id,updates))t.expect.truthy(r:Contribute(data().id,updates))
  t.expect.equal(r:Get(data().id).totals.XP,100)
 end)
 t.test("clan and social identity survive personal prestige",function()
  local p=P.New()p.clan={id=data().id,epoch="E1",state="active",contribution={XP=50}}p.social.invites="none"p.cycleXP=P.CycleCost
  P.Transition(p)local nextProfile=P.Migrate(p)t.expect.equal(nextProfile.clan.contribution.XP,50)t.expect.equal(nextProfile.social.invites,"none")
  local public=P.Public(nextProfile,1,"One")t.expect.equal(public.social,nil)t.expect.equal(public.clan.epoch,nil)
 end)
end
